{
  "backend": {
    "name": "github",
    "repo": "Zouriel/zouriel-portfolio",
    "branch": "master",
    "base_url": "https://api.netlify.com",
    "auth_endpoint": "auth"
  },
  "local_backend": true,
  "media_folder": "public/uploads",
  "public_folder": "/uploads",
  "site_url": "https://zouriel.dev",
  "display_url": "https://zouriel.dev",
  "logo_url": "/favicon.svg",
  "editor": { "preview": false },
  "collections": [
    {
      "name": "settings",
      "label": "Site Settings",
      "files": [
        {
          "name": "settings",
          "label": "Settings",
          "file": "public/content/settings.json",
          "fields": [
            { "name": "siteTitle", "label": "Site title", "widget": "string" },
            { "name": "location", "label": "Location", "widget": "string" },
            { "name": "timezone", "label": "Timezone", "widget": "string" },
            { "name": "copyright", "label": "Copyright line", "widget": "string" },
            {
              "name": "owner",
              "label": "Owner",
              "widget": "object",
              "fields": [
                { "name": "fullName", "label": "Full name", "widget": "string" },
                { "name": "shortName", "label": "Short / display name", "widget": "string" },
                { "name": "designation", "label": "Designation tagline", "widget": "string" },
                { "name": "email", "label": "Email", "widget": "string" }
              ]
            },
            {
              "name": "social",
              "label": "Social",
              "widget": "object",
              "fields": [
                { "name": "instagram", "label": "Instagram URL", "widget": "string", "required": false },
                { "name": "facebook", "label": "Facebook URL", "widget": "string", "required": false },
                { "name": "discordServer", "label": "Discord server URL", "widget": "string", "required": false },
                { "name": "github", "label": "GitHub URL", "widget": "string", "required": false },
                { "name": "strava", "label": "Strava URL", "widget": "string", "required": false },
                { "name": "linkedin", "label": "LinkedIn URL", "widget": "string", "required": false }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "navigation",
      "label": "Navigation",
      "files": [
        {
          "name": "navigation",
          "label": "Nav items",
          "file": "public/content/navigation.json",
          "fields": [
            {
              "name": "items",
              "label": "Items",
              "widget": "list",
              "fields": [
                { "name": "route", "label": "Route", "widget": "string" },
                { "name": "label", "label": "Label", "widget": "string" },
                {
                  "name": "icon",
                  "label": "Icon key",
                  "widget": "select",
                  "options": ["home", "projects", "dev", "work", "academics", "military", "athletics"]
                },
                { "name": "index", "label": "Index (e.g. \"01\")", "widget": "string" },
                { "name": "exact", "label": "Exact match", "widget": "boolean", "required": false, "default": false }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "home",
      "label": "Home Page",
      "files": [
        {
          "name": "home",
          "label": "Home",
          "file": "public/content/home.json",
          "fields": [
            { "name": "name", "label": "Full name", "widget": "string" },
            { "name": "designation", "label": "Designation", "widget": "string" },
            { "name": "email", "label": "Contact email", "widget": "string" },
            { "name": "description", "label": "Bio paragraph", "widget": "text" }
          ]
        }
      ]
    },
    {
      "name": "military",
      "label": "Military Page",
      "files": [
        {
          "name": "military",
          "label": "Military",
          "file": "public/content/military.json",
          "fields": [
            { "name": "branch", "label": "Branch (full)", "widget": "string" },
            { "name": "branchShort", "label": "Branch (short)", "widget": "string" },
            { "name": "period", "label": "Service period", "widget": "string" },
            { "name": "rank", "label": "Rank", "widget": "string" },
            { "name": "rankShort", "label": "Rank short (e.g. LCpl)", "widget": "string" },
            { "name": "qualification", "label": "Marksmanship qualification", "widget": "string" },
            { "name": "qualificationAwards", "label": "Marksmanship awards count", "widget": "number", "value_type": "int", "default": 0 },
            { "name": "bftScore", "label": "BFT score", "widget": "string" },
            { "name": "bftMax", "label": "BFT max", "widget": "string" },
            { "name": "bftPercent", "label": "BFT percent (0-100)", "widget": "number", "value_type": "int", "min": 0, "max": 100 },
            { "name": "summary", "label": "Service summary", "widget": "text" },
            {
              "name": "pillars",
              "label": "Pillars (values carried forward)",
              "widget": "list",
              "fields": [
                { "name": "word", "label": "Word (UPPER)", "widget": "string" },
                { "name": "meaning", "label": "Meaning", "widget": "string" }
              ]
            },
            {
              "name": "courses",
              "label": "Courses & qualifications",
              "widget": "list",
              "fields": [
                { "name": "title", "label": "Title", "widget": "string" },
                { "name": "org", "label": "Organisation", "widget": "string" },
                { "name": "glyph", "label": "Glyph", "widget": "select", "options": ["belt", "medal-bronze", "medal-silver", "corps"] },
                { "name": "detail", "label": "Detail", "widget": "string", "required": false }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "work",
      "label": "Work Experience",
      "files": [
        {
          "name": "work",
          "label": "Work entries",
          "file": "public/content/work.json",
          "fields": [
            {
              "name": "entries",
              "label": "Entries",
              "widget": "list",
              "fields": [
                { "name": "type", "label": "Type", "widget": "select", "options": ["work", "lecturer"], "default": "work" },
                { "name": "org", "label": "Organisation", "widget": "string" },
                { "name": "role", "label": "Role", "widget": "string" },
                { "name": "location", "label": "Location", "widget": "string", "required": false },
                { "name": "period", "label": "Period", "widget": "string" },
                { "name": "summary", "label": "One-line summary", "widget": "text", "required": false },
                {
                  "name": "highlights",
                  "label": "Highlights",
                  "widget": "list",
                  "field": { "name": "item", "label": "Highlight", "widget": "string" }
                },
                {
                  "name": "stack",
                  "label": "Stack",
                  "widget": "list",
                  "required": false,
                  "field": { "name": "tech", "label": "Tech", "widget": "string" }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "projects",
      "label": "Projects",
      "files": [
        {
          "name": "projects",
          "label": "Projects & categories",
          "file": "public/content/projects.json",
          "fields": [
            {
              "name": "categories",
              "label": "Categories",
              "widget": "list",
              "fields": [
                { "name": "key", "label": "Key", "widget": "select", "options": ["all", "fullstack", "frontend", "backend", "desktop", "infra", "experiment"] },
                { "name": "label", "label": "Label", "widget": "string" }
              ]
            },
            {
              "name": "projects",
              "label": "Projects",
              "widget": "list",
              "summary": "{{fields.name}} — {{fields.tagline}}",
              "fields": [
                { "name": "name", "label": "Name", "widget": "string" },
                { "name": "tagline", "label": "Tagline", "widget": "string" },
                { "name": "description", "label": "Description", "widget": "text" },
                {
                  "name": "stack",
                  "label": "Stack",
                  "widget": "list",
                  "field": { "name": "tech", "label": "Tech", "widget": "string" }
                },
                { "name": "category", "label": "Category", "widget": "select", "options": ["fullstack", "frontend", "backend", "desktop", "infra", "experiment"] },
                { "name": "language", "label": "Language label (e.g. \"Angular · .NET\")", "widget": "string" },
                { "name": "accent", "label": "Accent colour (hex)", "widget": "string", "pattern": ["^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$", "Must be a hex colour like #f59e0b"] },
                { "name": "year", "label": "Year", "widget": "string" },
                { "name": "repo", "label": "Repo URL", "widget": "string", "required": false },
                { "name": "live", "label": "Live URL", "widget": "string", "required": false },
                { "name": "featured", "label": "Featured", "widget": "boolean", "default": false },
                { "name": "cover", "label": "Cover image", "widget": "image", "required": false, "allow_multiple": false }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "development",
      "label": "Development Page",
      "files": [
        {
          "name": "development",
          "label": "Development",
          "file": "public/content/development.json",
          "fields": [
            { "name": "headline", "label": "Headline", "widget": "string" },
            { "name": "subhead", "label": "Subhead", "widget": "string" },
            { "name": "summary", "label": "Summary", "widget": "text" },
            {
              "name": "skillGroups",
              "label": "Skill groups",
              "widget": "list",
              "summary": "{{fields.title}}",
              "fields": [
                { "name": "title", "label": "Group title", "widget": "string" },
                {
                  "name": "items",
                  "label": "Items",
                  "widget": "list",
                  "summary": "{{fields.name}} — {{fields.level}}",
                  "fields": [
                    { "name": "name", "label": "Skill name", "widget": "string" },
                    { "name": "level", "label": "Level", "widget": "select", "options": ["Learning", "Working", "Advanced", "Expert"] },
                    { "name": "years", "label": "Years", "widget": "number", "value_type": "float", "required": false },
                    { "name": "note", "label": "Note", "widget": "string", "required": false }
                  ]
                }
              ]
            },
            {
              "name": "tools",
              "label": "Tools",
              "widget": "list",
              "field": { "name": "tool", "label": "Tool", "widget": "string" }
            }
          ]
        }
      ]
    },
    {
      "name": "education",
      "label": "Education Page",
      "files": [
        {
          "name": "education",
          "label": "Education",
          "file": "public/content/education.json",
          "fields": [
            { "name": "headline", "label": "Headline", "widget": "string" },
            { "name": "subhead", "label": "Subhead", "widget": "string" },
            { "name": "summary", "label": "Summary", "widget": "text" },
            {
              "name": "education",
              "label": "Education entries",
              "widget": "list",
              "summary": "{{fields.degree}}",
              "fields": [
                { "name": "degree", "label": "Degree / programme", "widget": "string" },
                { "name": "institution", "label": "Institution", "widget": "string" },
                { "name": "location", "label": "Location", "widget": "string", "required": false },
                { "name": "period", "label": "Period", "widget": "string" },
                { "name": "result", "label": "Result / grade", "widget": "string", "required": false },
                {
                  "name": "highlights",
                  "label": "Highlights",
                  "widget": "list",
                  "required": false,
                  "field": { "name": "item", "label": "Highlight", "widget": "string" }
                },
                {
                  "name": "coursework",
                  "label": "Coursework",
                  "widget": "list",
                  "required": false,
                  "field": { "name": "module", "label": "Module", "widget": "string" }
                }
              ]
            },
            {
              "name": "certifications",
              "label": "Certifications & training",
              "widget": "list",
              "summary": "{{fields.title}} — {{fields.issuer}}",
              "fields": [
                { "name": "title", "label": "Title", "widget": "string" },
                { "name": "issuer", "label": "Issuer", "widget": "string" },
                { "name": "location", "label": "Location", "widget": "string", "required": false },
                { "name": "date", "label": "Date", "widget": "string" },
                { "name": "category", "label": "Category", "widget": "select", "options": ["Certification", "Training", "License"], "required": false },
                {
                  "name": "notes",
                  "label": "Notes",
                  "widget": "list",
                  "required": false,
                  "field": { "name": "note", "label": "Note", "widget": "string" }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
